<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.15"
        android:text="FRIDAY"
        android:textColor="@color/orange_bright"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:alpha="0.8"
        android:text="Friday runs on your laptop. Pair this phone once, then say &quot;Friday, ...&quot; to use the laptop's own apps, files and hardware. Ordinary questions still go to JARVIS."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtFridayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_cyan"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/JarvisSection"
                        android:layout_marginTop="0dp"
                        android:text="CONNECTION" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFridayEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Let JARVIS send commands to Friday"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/editFridayHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@color/bg_card_alt"
                        android:hint="Laptop IP, e.g. 192.168.1.20"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="9dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_dim"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/editFridayPort"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:background="@color/bg_card_alt"
                            android:hint="Port"
                            android:inputType="number"
                            android:maxLines="1"
                            android:padding="9dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_dim"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/editFridayPrefix"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@color/bg_card_alt"
                            android:hint="Wake word, e.g. friday"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="9dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_dim"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFridaySave"
                            style="@style/JarvisButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SAVE"
                            android:textColor="@color/black"
                            app:backgroundTint="@color/cyan" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFridayTest"
                            style="@style/JarvisButton.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="TEST" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_orange"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/JarvisSection"
                        android:layout_marginTop="0dp"
                        android:text="PAIR THIS PHONE" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:text="On the laptop open Friday > Settings > Phone, generate a code there, then type it here. The code is single use and expires."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/editFridayCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@color/bg_card_alt"
                        android:hint="Pairing code, e.g. ABCD-EFGH"
                        android:inputType="textCapCharacters"
                        android:maxLength="9"
                        android:maxLines="1"
                        android:padding="9dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_dim"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFridayPair"
                        style="@style/JarvisButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="PAIR"
                        android:textColor="@color/black"
                        app:backgroundTint="@color/cyan" />

                    <TextView
                        android:id="@+id/txtFridayPairing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFridayUnpair"
                        style="@style/JarvisButton.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="UNPAIR THIS PHONE" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_cyan"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/JarvisSection"
                        android:layout_marginTop="0dp"
                        android:text="LAPTOP NOW" />

                    <TextView
                        android:id="@+id/txtFridayLive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFridayRefresh"
                        style="@style/JarvisButton.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="REFRESH STATUS" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFridayStop"
                        style="@style/JarvisButton.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="EMERGENCY STOP"
                        android:textColor="@color/orange_bright" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtFridayFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:paddingBottom="12dp"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
