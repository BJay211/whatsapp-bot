<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="REPLY"
            android:textColor="@color/cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReplySender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReplyMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtReplyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/green"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:text="THEY WROTE"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/txtReplyIncoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtReplyError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/red"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReplyAudit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.75"
            android:fontFamily="monospace"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:letterSpacing="0.15"
            android:text="YOUR REPLY (EXACT TEXT THAT WILL BE SENT)"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Type or edit the reply">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editReplyDraft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Instructions for JARVIS (optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editReplyInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            style="@style/JarvisButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="LET JARVIS REPLY" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegenerate"
            style="@style/JarvisButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="USE INSTRUCTIONS &amp; REDRAFT" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReadAloud"
                style="@style/JarvisButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="READ ALOUD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckStatus"
                style="@style/JarvisButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="CHECK STATUS" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprove"
            style="@style/JarvisButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="APPROVE &amp; SEND EXACT TEXT" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReplyMyself"
            style="@style/JarvisButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="REPLY MYSELF IN WHATSAPP" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReply"
            style="@style/JarvisButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CANCEL THIS REPLY" />

        <TextView
            android:id="@+id/txtReplyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/amber"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.65"
            android:text="Reading a draft, opening this screen or dictating instructions never sends anything. Only APPROVE &amp; SEND does, and the status shown afterwards is the workflow's real answer."
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
