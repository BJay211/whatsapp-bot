{
  "name": "bonjee-mobile",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~58.0.17",
    "expo-status-bar": "~58.0.4",
    "expo-font": "~12.0.4",
    "expo-linear-gradient": "~12.5.0",
    "expo-splash-screen": "~0.27.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "lucide-react-native": "0.468.0",
    "axios": "1.7.7",
    "date-fns": "3.6.0",
    "react-query": "3.39.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-native": "0.73.0",
    "typescript": "~6.0.3",
    "eslint": "~8.57.0",
    "eslint-config-expo": "~8.0.1"
  },
  "expo": {
    "name": "Bonjee Mobile",
    "slug": "bonjee-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      ["expo-font", {}],
      ["expo-linear-gradient", {}],
      ["expo-splash-screen", {}]
    ]
  }
}
